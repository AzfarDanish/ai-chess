# Address the IP Webcam app shows on the phone after you tap "Start server".
# Accepts the base URL ("http://192.168.1.50:8080") or a full stream URL
# ending in /video or /shot.jpg. Copy this file to .env.local and edit it.
PHONE_CAMERA_URL=http://192.168.1.50:8080

# OpenRouter API key used to read the chess board with a DeepSeek vision
# model. The key is only used server-side (app/api/vision). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults shown):
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
